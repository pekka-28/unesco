{
  "name": "my-world-heritage",
  "version": "1.0.0",
  "description": "My World Heritage site build and checks",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build_pages.mjs",
    "typecheck": "tsc --noEmit && node scripts/check_site_types.mjs && npm run typecheck:server",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck:server": "tsc -p tsconfig.supabase.json && node scripts/check_server_types.mjs"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@types/deno": "^2.7.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "html2canvas": "^1.4.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "private": true
}
