{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "leaflet",
      "emscripten"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowUmdGlobalAccess": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
