{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "ESNext.Disposable",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "deno"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "supabase/functions/**/*.ts"
  ]
}
